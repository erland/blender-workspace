{
  "name": "blender-workspace-mcp",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild viewer/client.js --bundle --format=esm --target=es2022 --outfile=dist/viewer.js && esbuild viewer/public-client.js --bundle --format=esm --target=es2022 --outfile=dist/public-viewer.js",
    "start": "node dist/main.js",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec __tests__/*.test.mjs",
    "check": "npm run build && npm test",
    "db:migrate": "node dist/db/migrate-cli.js",
    "build:server": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "fastify": "5.6.2",
    "zod": "4.6.7",
    "pg": "8.13.1",
    "jose": "6.2.17",
    "modal": "0.11.2",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.11.10",
    "typescript": "5.9.3",
    "esbuild": "0.25.5"
  }
}
