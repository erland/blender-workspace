# Choose one: internal (development), oauth (external issuer), google (built-in Google login)
MCP_AUTH_MODE=google
PUBLIC_ORIGIN=https://blender.example.org
# Preferred Coolify connection settings: enter PGPASSWORD as a masked secret in the UI.
PGHOST=private-postgres-host
PGPORT=5432
PGUSER=blender_workspace_app
PGPASSWORD=<set-as-a-Coolify-secret>
PGDATABASE=blender_workspace
# Legacy alternative only (never combine with PG* settings):
# DATABASE_URL=<connection-string>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<Coolify secret>
OAUTH_SIGNING_KEY=<base64-Ed25519-PKCS8-DER>
OAUTH_SESSION_SECRET=<random-secret-at-least-32-characters>
GOOGLE_ALLOWED_REDIRECT_ORIGINS=https://your-trusted-chatgpt-redirect-origin.example
GOOGLE_ALLOWED_EMAILS=your-email@example.com
# External OAuth mode instead: OAUTH_ISSUER=... and OAUTH_JWKS_URI=...
# Internal development instead: MCP_ACCESS_TOKEN=... and MCP_OWNER_KEY=...
PORT=3000
HOST=0.0.0.0
ARTIFACT_ROOT=/data/blender-workspace

# DEV-048 Modal App (within each connected owner's Modal workspace), not workspace account name.
# Default: blender-workspace. Optional override goes on the job worker in Coolify.
MODAL_APP_NAME=blender-workspace

# DEV-009 personal Modal accounts (same key for MCP service and job worker)
# Generate securely: openssl rand -base64 32
MODAL_CREDENTIAL_ENCRYPTION_KEY=<base64-32-byte-key-in-Coolify-secrets>
# Do not enable MODAL_EXECUTION_MODE=legacy for public/multi-user deployments.
