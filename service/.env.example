# Generate a random token: openssl rand -hex 32
MCP_ACCESS_TOKEN=replace-with-a-generated-64-character-secret
PUBLIC_ORIGIN=https://blender.example.org
PORT=3000
HOST=0.0.0.0
# Dedicated database/user on your existing PostgreSQL instance; never commit credentials
DATABASE_URL=postgres://blender_workspace_user:replace-password@postgres-host:5432/blender_workspace
