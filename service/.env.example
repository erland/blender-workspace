# Choose one: internal (development), oauth (external issuer), google (built-in Google login)
MCP_AUTH_MODE=google
PUBLIC_ORIGIN=https://blender.example.org
DATABASE_URL=postgres://dedicated-user:secret@postgres-host:5432/blender_workspace
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<Coolify secret>
OAUTH_SIGNING_KEY=<base64-Ed25519-PKCS8-DER>
OAUTH_SESSION_SECRET=<random-secret-at-least-32-characters>
GOOGLE_ALLOWED_REDIRECT_ORIGINS=https://your-trusted-chatgpt-redirect-origin.example
GOOGLE_ALLOWED_EMAILS=your-email@example.com
# External OAuth mode instead: OAUTH_ISSUER=... and OAUTH_JWKS_URI=...
# Internal development instead: MCP_ACCESS_TOKEN=... and MCP_OWNER_KEY=...
PORT=3000
HOST=0.0.0.0
ARTIFACT_ROOT=/data/blender-workspace
