# Internal mode (development only; not Internet-facing)
MCP_AUTH_MODE=internal
MCP_ACCESS_TOKEN=replace-with-a-generated-64-character-secret
MCP_OWNER_KEY=internal-workspace
# OAuth mode instead: remove MCP_ACCESS_TOKEN and MCP_OWNER_KEY
# MCP_AUTH_MODE=oauth
# OAUTH_ISSUER=https://identity.example.org/realms/blender
# OAUTH_JWKS_URI=https://identity.example.org/realms/blender/protocol/openid-connect/certs
PUBLIC_ORIGIN=https://blender.example.org
DATABASE_URL=postgres://blender_workspace_user:replace-password@postgres-host:5432/blender_workspace
PORT=3000
HOST=0.0.0.0
ARTIFACT_ROOT=/data/blender-workspace
